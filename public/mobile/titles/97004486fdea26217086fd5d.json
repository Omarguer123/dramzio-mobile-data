{"id":"en_the-price-of-prejudice","title":"The Price of Prejudice","titleEn":"The Price of Prejudice","description":"Nia keeps her background as the hidden heiress of V.A.R.H. Lux Group a secret so she can stand behind Kane, her impoverished but gifted lover. Over four years she helps him build L-Astra, the brand he dreamed of, and intends to install him as its CEO. Everything changes when Kane comes back with Hila. He turns on Nia, ruins the gift she had prepared and subjects her to humiliation. As she sinks into despair, three golden lion helicopters appear and her real identity comes to light.","poster":"https://cdn2.nsstorage.space/the-price-of-prejudice/en_US/a07426ca32bd65ac/cover.webp","backdrop":"https://cdn2.nsstorage.space/the-price-of-prejudice/en_US/a07426ca32bd65ac/cover.webp","kind":"series","year":2025,"genres":["Karma Payback","Modern Romance","Multiple Identities","Short Drama"],"featured":false,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dsh4i/?pub=4occak","kind":"embed","downloadable":false}],"episodes":[{"id":"ep_the-price-of-prejudice_1","title":"Episode 1","season":1,"number":1,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dsh4i/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-price-of-prejudice_2","title":"Episode 2","season":1,"number":2,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dsh4i/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-price-of-prejudice_3","title":"Episode 3","season":1,"number":3,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dsh4i/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-price-of-prejudice_4","title":"Episode 4","season":1,"number":4,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dsh4i/?pub=4occak","kind":"embed","downloadable":false}]},{