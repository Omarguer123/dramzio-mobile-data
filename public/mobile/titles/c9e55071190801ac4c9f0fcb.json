{"id":"en_fabulous-at-fifty","title":"Fabulous at Fifty","titleEn":"Fabulous at Fifty","description":"Twin sisters are separated as children by a fire and a father whose negligence drives them apart. The elder twin, Zhao Ruoqi, grows up to become a CEO and spends her adult life searching for her sibling. When she finally locates her younger twin, she finds her in danger. Drawing on her intelligence and resources, Zhao Ruoqi sets out to take cunning revenge on the abusive father and the treacherous nanny responsible, seeking to restore justice and the family's honor.","poster":"https://cdn2.nsstorage.space/fabulous-at-fifty/en_US/e34db6d32d7c0298/cover.webp","backdrop":"https://cdn2.nsstorage.space/fabulous-at-fifty/en_US/e34db6d32d7c0298/cover.webp","kind":"series","year":2025,"genres":["Avenge","Business War","CEO","Independent Woman","Karma","Love"],"featured":false,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dnef2/?pub=4occak","kind":"embed","downloadable":false}],"episodes":[{"id":"ep_fabulous-at-fifty_1","title":"Episode 1","season":1,"number":1,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dnef2/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_fabulous-at-fifty_2","title":"Episode 2","season":1,"number":2,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dnef2/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_fabulous-at-fifty_3","title":"Episode 3","season":1,"number":3,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dnef2/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_fabulous-at-fifty_4","title":"Episode 4","season":1,"number":4,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dnef2/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_fabulous-at-fifty_5","title":"Episode 5","season":1,"num