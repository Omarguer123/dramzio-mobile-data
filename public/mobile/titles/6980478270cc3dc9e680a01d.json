{"id":"en_glass-steps","title":"Glass Steps","titleEn":"Glass Steps","description":"Architect Vanessa Chen works as an accessible public architecture designer, and her career is marked by workplace plagiarism and broader industry injustice. She sets out to defend her original designs and the inclusive principles behind them, pushing back against unfair industry rules. Her struggle unfolds across six arcs, beginning with an initial humiliation and building toward her leading a reform effort for human-centered public architecture that serves all people.","poster":"https://cdn2.nsstorage.space/glass-steps/en_US/aa64878db21a1516/cover.webp","backdrop":"https://cdn2.nsstorage.space/glass-steps/en_US/aa64878db21a1516/cover.webp","kind":"series","year":2025,"genres":["Designer","Female","Girl Power","Growth","Independent Woman","Rags to Riches"],"featured":false,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm61w/?pub=4occak","kind":"embed","downloadable":false}],"episodes":[{"id":"ep_glass-steps_1","title":"Episode 1","season":1,"number":1,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm61w/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_glass-steps_2","title":"Episode 2","season":1,"number":2,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm61w/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_glass-steps_3","title":"Episode 3","season":1,"number":3,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm61w/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_glass-steps_4","title":"Episode 4","season":1,"number":4,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm61w/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_glass-steps_5","title":"Episode 5","season":1,"number":5,"sources":[{"id":"rumble-0","label":