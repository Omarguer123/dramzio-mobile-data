{"id":"en_the-amazing-doctor","title":"The Amazing Doctor","titleEn":"The Amazing Doctor","description":"Chester Shaw, the Ticali Sect’s heir, was born with an unusually warm body that gave him remarkable cultivation talent. At twenty-four, confronted by a threat to his life, he descended from the mountain to honor a marriage contract and change his fate. The Zacker family received him with contempt, and Louis Zacker broke off the engagement, unaware of how deeply their destinies were connected.","poster":"https://cdn2.nsstorage.space/the-amazing-doctor/en_US/4c70d875c2df60ab/cover.webp","backdrop":"https://cdn2.nsstorage.space/the-amazing-doctor/en_US/4c70d875c2df60ab/cover.webp","kind":"series","year":2025,"genres":["Faceslapping","Urban","Short Drama"],"featured":false,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dchlc/?pub=4occak","kind":"embed","downloadable":false}],"episodes":[{"id":"ep_the-amazing-doctor_1","title":"Episode 1","season":1,"number":1,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dchlc/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-amazing-doctor_2","title":"Episode 2","season":1,"number":2,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dchlc/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-amazing-doctor_3","title":"Episode 3","season":1,"number":3,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dchlc/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-amazing-doctor_4","title":"Episode 4","season":1,"number":4,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dchlc/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-amazing-doctor_5","title":"Episode 5","season":1,"number":5,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/em