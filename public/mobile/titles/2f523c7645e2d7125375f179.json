{"id":"en_the-trillionaire-bodyguard","title":"The Trillionaire Bodyguard","titleEn":"The Trillionaire Bodyguard","description":"She is adored across the nation, while he exists as the silent figure always near her. The public sees only a bodyguard, yet behind that role lies a name so powerful that nobody ventures to say it aloud. He goes into the arrangement convinced he is the one doing the hunting. Only later does it dawn on him that he has stepped directly into her trap.","poster":"https://cdn2.nsstorage.space/5d0fb3b4af80c165/zh_TW/9782818ad3d5a28e/cover.webp","backdrop":"https://cdn2.nsstorage.space/5d0fb3b4af80c165/zh_TW/9782818ad3d5a28e/cover.webp","kind":"series","year":2025,"genres":["Revenge","Hidden Identity","Romance","Contemporary","Urban","Power Couple"],"featured":false,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7difzo/?pub=4occak","kind":"embed","downloadable":false}],"episodes":[{"id":"ep_the-trillionaire-bodyguard_1","title":"Episode 1","season":1,"number":1,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7difzo/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-trillionaire-bodyguard_2","title":"Episode 2","season":1,"number":2,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7difzo/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-trillionaire-bodyguard_3","title":"Episode 3","season":1,"number":3,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7difzo/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-trillionaire-bodyguard_4","title":"Episode 4","season":1,"number":4,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7difzo/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_the-trillionaire-bodyguard_5","title":"Episode 5","season":1,"number":5,"sources":[{"id":"rumble-0","lab