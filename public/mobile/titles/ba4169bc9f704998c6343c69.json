{"id":"en_undercover-in-the-dead-zone","title":"Undercover in the Dead Zone","titleEn":"Undercover in the Dead Zone","description":"A remote stretch of lawless territory has long been the hunting ground for a gang of drivers who prey on women traveling through. Chu Qing arrives there under the guise of a fresh graduate, but her real identity is that of a young reporter looking into how her sister died. To get at the truth, she embeds herself inside the very vehicles used by the killers.","poster":"https://cdn2.nsstorage.space/undercover-in-the-dead-zone/en_US/cf4a25562a758e10/cover.webp","backdrop":"https://cdn2.nsstorage.space/undercover-in-the-dead-zone/en_US/cf4a25562a758e10/cover.webp","kind":"series","year":2025,"genres":["Friends to Lovers","Revenge","Short Drama"],"featured":false,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm7h8/?pub=4occak","kind":"embed","downloadable":false}],"episodes":[{"id":"ep_undercover-in-the-dead-zone_1","title":"Episode 1","season":1,"number":1,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm7h8/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_undercover-in-the-dead-zone_2","title":"Episode 2","season":1,"number":2,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm7h8/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_undercover-in-the-dead-zone_3","title":"Episode 3","season":1,"number":3,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm7h8/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_undercover-in-the-dead-zone_4","title":"Episode 4","season":1,"number":4,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7dm7h8/?pub=4occak","kind":"embed","downloadable":false}]},{"id":"ep_undercover-in-the-dead-zone_5","title":"Episode 5","season":1,"number":5,"sources":[{"id":"rumble-