{"id":"en_switched-at-the-altar","title":"Switched at the Altar","titleEn":"Switched at the Altar","description":"Victoria, a female general who has been forced into retirement, finds herself used as a piece in her stepmother Helen's merciless scheme. Helen intends to wed Victoria to a dying invalid, while arranging for her own daughter Charlotte to marry Prince Alexander. On the wedding day, however, the plan unravels: the sisters get into the wrong carriages and end up marrying each other's intended grooms.","poster":"https://cdn1.nsstorage.space/a649f1c134b64d86/zh_TW/9782818ad3d5a28e/cover.webp","backdrop":"https://cdn1.nsstorage.space/a649f1c134b64d86/zh_TW/9782818ad3d5a28e/cover.webp","kind":"series","year":2025,"genres":["Romance","Romance","Short Drama"],"featured":false,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7ct7py/?pub=4p6i0m","kind":"embed","downloadable":false}],"episodes":[{"id":"ep_switched-at-the-altar_1","title":"Episode 1","season":1,"number":1,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7ct7py/?pub=4p6i0m","kind":"embed","downloadable":false}]},{"id":"ep_switched-at-the-altar_2","title":"Episode 2","season":1,"number":2,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7ct7py/?pub=4p6i0m","kind":"embed","downloadable":false}]},{"id":"ep_switched-at-the-altar_3","title":"Episode 3","season":1,"number":3,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7ct7py/?pub=4p6i0m","kind":"embed","downloadable":false}]},{"id":"ep_switched-at-the-altar_4","title":"Episode 4","season":1,"number":4,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":"https://rumble.com/embed/v7ct7py/?pub=4p6i0m","kind":"embed","downloadable":false}]},{"id":"ep_switched-at-the-altar_5","title":"Episode 5","season":1,"number":5,"sources":[{"id":"rumble-0","label":"Rumble HD (Ad-Free)","url":